@prefix reo:  <http://re-environment-onto.org/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ============================================================
# REO DERIVATION MODULE — version 1.1.0
#
# Vocabulary for candidate requirements, their explicit mapping to
# environment elements (the "annotation" consumed by the derivation
# contract), requirement-level decision states, and persistent
# decision records aligned with W3C PROV-O.
#
# PROV-O terms are declared locally (no owl:imports) so that the module
# can be classified offline; the declarations coincide with PROV-O.
# ============================================================

<http://re-environment-onto.org/ontology/derivation>
    a owl:Ontology ;
    dcterms:title "RE-Environment Ontology (REO) - derivation module"@en ;
    dcterms:description "Candidate requirements, decision states and PROV-O-aligned decision records for the REO derivation contract."@en ;
    dcterms:creator "Nihal Salih", "Mohamed Amine El Youssr", "Tarik Fissaa", "Mahmoud El Hamlaoui" ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    owl:imports <http://re-environment-onto.org/ontology> ;
    owl:versionInfo "1.1.0" ;
    owl:versionIRI <http://re-environment-onto.org/ontology/derivation/1.1.0> .

# ------------------------------------------------------------
# PROV-O alignment (local declarations of the reused terms)
# ------------------------------------------------------------
prov:Entity   a owl:Class ; rdfs:label "Entity"@en .
prov:Activity a owl:Class ; rdfs:label "Activity"@en .
prov:used a owl:ObjectProperty ; rdfs:domain prov:Activity ; rdfs:label "used"@en .
prov:wasGeneratedBy a owl:ObjectProperty ; rdfs:domain prov:Entity ; rdfs:range prov:Activity ; rdfs:label "was generated by"@en .
prov:startedAtTime a owl:DatatypeProperty ; rdfs:domain prov:Activity ; rdfs:range xsd:dateTime ; rdfs:label "started at time"@en .

# ------------------------------------------------------------
# Classes
# ------------------------------------------------------------
reo:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    skos:definition """A candidate requirement statement together with its explicit
    mapping to environment elements (seed goal, context, actor, actions, domain
    concepts and properties, interaction, declared constraints). The text is kept
    for presentation; the mapping is what the derivation contract evaluates.""" .

reo:DerivationRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Derivation Record"@en ;
    skos:definition """Persistent result of assessing one requirement against one
    environment snapshot under one validation policy: decision state,
    justifications and the trace of consulted environment elements.""" .

reo:ValidationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Validation Activity"@en ;
    skos:definition "Execution of the derivation contract that generated a derivation record. The elements it consulted form the record's trace." .

reo:DecisionState a owl:Class ;
    rdfs:label "Decision State"@en ;
    skos:definition "Requirement-level decision state assigned by the derivation contract." ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( reo:Accepted reo:AcceptedWithReservations reo:Conditional
                    reo:PendingReview reo:Rejected reo:NotDerived ) ] .

reo:Accepted a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "accepted"@en ;
    skos:definition "Every induced mandatory obligation passed and no blocking or affecting uncertainty is open." .
reo:AcceptedWithReservations a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "accepted with reservations"@en ;
    skos:definition "Hard obligations passed; at least one soft obligation failed or is unchecked." .
reo:Conditional a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "conditional"@en ;
    skos:definition "Hard obligations passed, but an unvalidated uncertainty blocks the seed lineage or affects consulted evidence." .
reo:PendingReview a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "pending review"@en ;
    skos:definition "A mandatory obligation could not be checked (no validator, missing definition, conflicting evidence, invalidated evidence)." .
reo:Rejected a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "rejected"@en ;
    skos:definition "At least one checked hard obligation failed, or a premise blocking the seed lineage was refuted." .
reo:NotDerived a reo:DecisionState , owl:NamedIndividual ;
    rdfs:label "not derived"@en ;
    skos:definition "No anchoring slice exists (undefined seed goal or context)." .

[] a owl:AllDifferent ;
   owl:distinctMembers ( reo:Accepted reo:AcceptedWithReservations reo:Conditional
                         reo:PendingReview reo:Rejected reo:NotDerived ) .

[] a owl:AllDisjointClasses ;
   owl:members ( reo:Requirement reo:DerivationRecord reo:ValidationActivity reo:DecisionState
                 reo:Actor reo:Goal reo:DomainConcept reo:Constraint reo:Context
                 reo:Uncertainty reo:Interaction ) .

# ------------------------------------------------------------
# Requirement annotation (mapping to environment elements)
# ------------------------------------------------------------
reo:requirementId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain reo:Requirement ; rdfs:range xsd:string ; rdfs:label "requirement ID"@en .
reo:requirementText a owl:DatatypeProperty ;
    rdfs:domain reo:Requirement ; rdfs:range xsd:string ; rdfs:label "requirement text"@en ;
    skos:definition "Natural-language statement; not parsed by the reference checker." .
reo:hasSeedGoal a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Goal ; rdfs:label "has seed goal"@en .
reo:assessedInContext a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Context ; rdfs:label "assessed in context"@en .
reo:hasResponsibleActor a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Actor ; rdfs:label "has responsible actor"@en ;
    skos:definition "Actor who must perform the required behaviour." .
reo:performsAction a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Action ; rdfs:label "performs action"@en ;
    skos:definition "Action that the responsible actor performs; each one induces a capability obligation and may trigger rule antecedents." .
reo:requiresAuthorityOf a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Actor ; rdfs:label "requires authority of"@en .
reo:refersToConcept a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:DomainConcept ; rdfs:label "refers to concept"@en .
reo:refersToProperty a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:DomainProperty ; rdfs:label "refers to property"@en ;
    skos:definition "Domain property referenced by the statement; the owning concept is given by reo:hasProperty." .
reo:usesInteraction a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Interaction ; rdfs:label "uses interaction"@en .
reo:expectsInteractionSource a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Actor ; rdfs:label "expects interaction source"@en ;
    skos:definition "Expected originating actor of the used interaction (direction check)." .
reo:requiresProtocol a owl:DatatypeProperty ;
    rdfs:domain reo:Requirement ; rdfs:range xsd:boolean ; rdfs:label "requires protocol"@en .
reo:declaresHardConstraint a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Constraint ; rdfs:label "declares hard constraint"@en .
reo:declaresSoftConstraint a owl:ObjectProperty ;
    rdfs:domain reo:Requirement ; rdfs:range reo:Constraint ; rdfs:label "declares soft constraint"@en .

# ------------------------------------------------------------
# Decision records (PROV-O aligned)
# ------------------------------------------------------------
reo:assesses a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range reo:Requirement ; rdfs:label "assesses"@en .
reo:hasDecision a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range reo:DecisionState ; rdfs:label "has decision"@en .
reo:hasJustification a owl:DatatypeProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range xsd:string ; rdfs:label "has justification"@en .
reo:environmentSnapshot a owl:DatatypeProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range xsd:string ; rdfs:label "environment snapshot"@en ;
    skos:definition "Content hash of the environment snapshot (canonical N-Triples, SHA-256)." .
reo:policyVersion a owl:DatatypeProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range xsd:string ; rdfs:label "policy version"@en .
reo:consulted a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain reo:ValidationActivity ; rdfs:label "consulted"@en ;
    skos:definition "Environment element read by the validation activity; the set of consulted elements is the record's trace." .
reo:supersedes a owl:ObjectProperty ;
    rdfs:domain reo:DerivationRecord ; rdfs:range reo:DerivationRecord ; rdfs:label "supersedes"@en ;
    skos:definition "Link from a re-derived record to the record it replaces after an environment change." .

# --- Definitions added after the v1.1.0 pitfall scan (P08) ---
reo:assessedInContext skos:definition "Context under which the requirement is assessed."@en .
reo:assesses skos:definition "Requirement assessed by the derivation record."@en .
reo:declaresHardConstraint skos:definition "Constraint that the requirement explicitly declares as a mandatory obligation."@en .
reo:declaresSoftConstraint skos:definition "Constraint that the requirement explicitly declares as an advisory obligation."@en .
reo:hasDecision skos:definition "Decision state assigned by the derivation contract."@en .
reo:hasJustification skos:definition "Human-readable justification recorded for one obligation outcome."@en .
reo:hasSeedGoal skos:definition "Goal from which the requirement is derived; anchors the seed slice."@en .
reo:policyVersion skos:definition "Version of the validation policy (decision order and validator registry) applied."@en .
reo:refersToConcept skos:definition "Domain concept referenced by the requirement statement."@en .
reo:requirementId skos:definition "Unique identifier of the requirement."@en .
reo:requiresAuthorityOf skos:definition "Actor whose authority level the requirement relies on."@en .
reo:requiresProtocol skos:definition "Whether the used interaction must declare a protocol."@en .
reo:usesInteraction skos:definition "Interaction through which the required behaviour exchanges data."@en .

# --- Explicit range added after the v1.1.0 pitfall scan (P11) ---
reo:consulted rdfs:range owl:Thing .
